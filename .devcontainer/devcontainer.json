{
  "name": "SuperKart Model Deployment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {
      "label": "SuperKart Backend API",
      "onAutoForward": "openPreview"
    },
    "8501": {
      "label": "SuperKart Streamlit Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "docker compose build",
  "postStartCommand": "docker compose up -d"
}
