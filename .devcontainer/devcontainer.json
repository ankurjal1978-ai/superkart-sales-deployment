{
  "name": "SuperKart Model Deployment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {
      "label": "SuperKart Backend API",
      "onAutoForward": "openPreview"
    },
    "8501": {
      "label": "SuperKart Streamlit Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install --user -r backend/requirements.txt -r frontend/requirements.txt && python backend/train_model.py",
  "postStartCommand": "bash .devcontainer/start.sh"
}
